# Configuración del dominio
BW_DOMAIN=vault.tu-dominio.com

# Configuración de la base de datos
BW_DB_PROVIDER=mysql
BW_DB_SERVER=db
BW_DB_DATABASE=bitwarden_vault
BW_DB_USERNAME=bitwarden
BW_DB_PASSWORD=super_strong_password # Debe coincidir con el docker-compose

# Configuración de SSL (si no usas un proxy inverso)
BW_ENABLE_SSL=true
BW_SSL_CERT=/etc/bitwarden/ssl.crt
BW_SSL_KEY=/etc/bitwarden/ssl.key

# Configuración de correo (SMTP)
globalSettings__mail__smtp__host=smtp.tu-proveedor.com
globalSettings__mail__smtp__port=587
globalSettings__mail__smtp__ssl=true
globalSettings__mail__smtp__username=tu-correo@ejemplo.com
globalSettings__mail__smtp__password=tu-contraseña-smtp
globalSettings__mail__replyToEmail=tu-correo@ejemplo.com