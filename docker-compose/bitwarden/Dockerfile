# Utiliza la imagen oficial de Bitwarden
FROM ghcr.io/bitwarden/self-host:beta

# (Opcional) Aquí puedes añadir pasos para personalizar la imagen,
# como copiar archivos de configuración, certificados, etc.
# Por ejemplo, para copiar tu propio archivo de configuración:
# COPY ./mi-configuracion.env /etc/bitwarden/settings.env

# (Opcional) Exponer los puertos que Bitwarden usa por defecto.
# Normalmente se gestionan en el docker-compose, pero es una buena práctica.
# EXPOSE 8080 8443

# La imagen oficial ya define un ENTRYPOINT y CMD para iniciar los servicios.